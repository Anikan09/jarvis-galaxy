# ---- Never commit: secrets and keys (encrypted or not) ----
config.json
secrets.json
auth.json
auth.json.tmp
token.json
credentials.json
*.pem
*.key
.env
.env.*

# ---- Never commit: personal data a running Jarvis creates ----
