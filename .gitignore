/notes/
/vault/
timemachine.db*
actions.log
reminders.json
events.json
lang.json
known_devices.json
sentinel.json
posture.json
notices.json
tripwires.json
screen-guide/*.png
demo-outbox.jsonl
/backups/
# demo mode's runtime files (its notes ship, its activity doesn't)
demo/actions.log
demo/reminders.json
demo/notices.json

# ---- Generated ----
viewer/graph-data.js
viewer/graph-data.js.tmp
*.tmp
*.part

